# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logger

# Auth — minimum 32 characters (generate with: openssl rand -base64 32)
AUTH_SECRET=

# App — also the base URL used for invite links and alert webhook payloads
APP_URL=http://localhost

# Node
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace (default info)
LOG_LEVEL=info

# Worker (set to "true" to run pg-boss jobs in the Next.js process during dev)
# In production, use a dedicated worker container (see feature 08)
WORKER_IN_PROCESS=false

# Fallback ingest rate limit (events per 60s) for API keys with no per-key override
RATE_LIMIT_PER_MIN=1000

# Allow alert webhooks to target private/loopback addresses (SSRF guard opt-out).
# Only enable for self-hosted installs posting to a service on the same network.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Build telemetry — set by CI at build time, exposed via /api/version
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME=
