# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/.next-e2e/
/out/

# production
/build
# esbuild output for the worker + migrate entrypoints (npm run build:worker)
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is what a fresh clone
# copies to .env.local. The blanket .env* rule had been swallowing it, so the
# repo shipped with no env template at all despite the docs referencing one.
!.env.example
# Same reasoning for the production template — it is documentation, not secrets.
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Local scratch copies of the load generators. The tracked ones read their key
# from .env.local and must keep doing so - a key baked into a committed file
# survives its own deletion, in the history and in every fork and cache that
# history reaches. This repository is public.
scripts/*.local.mjs

# Phase 0 lab output — measurement artifacts, regenerated on every run.
lab/clickhouse/out/
