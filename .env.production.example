# Production configuration template.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Keep it named `.env` in the same directory as docker-compose.yml. Compose
# reads that file twice and both uses matter: once for `${VAR}` substitution
# inside the compose file itself (DOMAIN, POSTGRES_*), and once to inject
# `env_file:` variables into the containers. Pointing `--env-file` somewhere
# else covers only the second.
#
# Every value below is read at run time, so changing one needs
# `docker compose up -d` — not a rebuild. The three exceptions are marked.

# ── Public hostname ───────────────────────────────────────────────────────────
# Caddy requests a Let's Encrypt certificate for exactly this name, so it must
# already resolve to this host. For a local test with no DNS, use `:80` — Caddy
# then serves plain HTTP and skips ACME entirely.
DOMAIN=logger.example.com

# ── Database ──────────────────────────────────────────────────────────────────
# `postgres` is the compose service name; the database is not published to the
# host. Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_DB=logger
POSTGRES_USER=logger
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://logger:change-me@postgres:5432/logger

# ── Postgres tuning (optional) ────────────────────────────────────────────────
# Passed to the postgres command line by docker-compose.yml. The values below
# are Postgres's own defaults — the variables exist so a setting *can* be
# changed and measured, not because these are the right numbers for your host.
#
# Read docs/PLAN.md §16.1 Stage C before changing them: picking values without
# a before/after measurement on the real host is guesswork, and a developer
# machine cannot produce that measurement (its page cache holds the whole
# working set, so every shared_buffers value looks identical).
#
# A common starting point on a dedicated database host is shared_buffers ≈ 25%
# of RAM and effective_cache_size ≈ 50–75%. This install is not dedicated —
# the app, the worker and Postgres share one machine — so 25% is an upper
# bound, not a target. Changing any of these requires restarting postgres.
#PG_SHARED_BUFFERS=128MB
#PG_WORK_MEM=4MB
#PG_EFFECTIVE_CACHE_SIZE=4GB
#PG_MAINTENANCE_WORK_MEM=64MB
#PG_RANDOM_PAGE_COST=4.0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters; the app refuses to boot below that. Generate with:
#   openssl rand -base64 32
# Changing it invalidates every existing session.
AUTH_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL for invitation links and alert webhook payloads. Must match DOMAIN,
# including the scheme — a wrong value here produces webhooks whose events_url
# points somewhere nobody can open, and nothing else visibly breaks.
APP_URL=https://logger.example.com

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Fallback ingest quota (events per 60s) for API keys with no per-key override.
RATE_LIMIT_PER_MIN=1000

# Lets alert webhooks reach private/loopback addresses. Leave false unless this
# install genuinely posts to a service on the same private network — enabling it
# turns the webhook sender into an SSRF primitive.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Runs pg-boss inside the Next.js process. Must stay false in production: the
# `worker` service is the job runner, and turning this on would give the alert
# evaluator a second scheduler racing the first.
WORKER_IN_PROCESS=false

# NODE_ENV is deliberately NOT set here. It is baked into the image
# (`ENV NODE_ENV=production` in the Dockerfile) so that all three processes get
# it — `app`, and equally the plain-`node` `worker` and `migrate` containers,
# which have no framework to default it for them. Setting it here as well is
# harmless; setting it to anything other than `production` silently selects
# development branches, including the pooled-client global in core/db/client.ts.

# ── Container port ────────────────────────────────────────────────────────────
# What the app listens on inside its container. Defaults to the image's baked-in
# 3000 if unset. It is NOT the 80 that `npm run start` uses locally — that only
# governs a local `next start`, which the container never runs. Changing this
# means changing `ENV PORT` in the Dockerfile and `reverse_proxy app:3000` in
# the Caddyfile to match.
PORT=3000

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
# Local copies to keep. Small on purpose — the offsite bucket is the archive,
# local files exist to make a same-day restore fast.
BACKUP_RETENTION_COUNT=3

# Offsite copy via rclone. With OFFSITE=true, RCLONE_REMOTE is required and the
# backup container refuses to start without it.
OFFSITE=false
RCLONE_REMOTE=b2:logger-backups/logger.example.com

# The remote is configured through rclone's own environment variables rather
# than an rclone.conf file, so every secret stays in this one file. The segment
# after RCLONE_CONFIG_ is the remote name used in RCLONE_REMOTE above, upper-
# cased. Example for Backblaze B2 (remote named `b2`):
#
#   RCLONE_CONFIG_B2_TYPE=b2
#   RCLONE_CONFIG_B2_ACCOUNT=...
#   RCLONE_CONFIG_B2_KEY=...
#
# Or for any S3-compatible bucket (remote named `s3`):
#
#   RCLONE_CONFIG_S3_TYPE=s3
#   RCLONE_CONFIG_S3_PROVIDER=Other
#   RCLONE_CONFIG_S3_ENDPOINT=https://...
#   RCLONE_CONFIG_S3_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=...

# ── Build metadata (build time only) ──────────────────────────────────────────
# Surfaced by GET /api/version. These are NEXT_PUBLIC_, so `next build` inlines
# them into the client bundle: they are read as build args and setting them here
# after the fact has no effect. The release workflow passes them automatically;
# set them only for a manual `docker compose build`.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME=

# Image `docker compose` builds and runs. Leave as-is to build from this
# checkout; point it at a published tag (ghcr.io/<owner>/logger:v1.2.3) to
# deploy a prebuilt image instead — see docs/OPERATIONS.md.
IMAGE=logger:latest
