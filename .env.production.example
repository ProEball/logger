# Production configuration template.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Keep it named `.env` in the same directory as docker-compose.yml. Compose
# reads that file twice and both uses matter: once for `${VAR}` substitution
# inside the compose file itself (DOMAIN, POSTGRES_*), and once to inject
# `env_file:` variables into the containers. Pointing `--env-file` somewhere
# else covers only the second.
#
# Every value below is read at run time, so changing one needs
# `docker compose up -d` — not a rebuild. The three exceptions are marked.

# ── Public hostname ───────────────────────────────────────────────────────────
# Caddy requests a Let's Encrypt certificate for exactly this name, so it must
# already resolve to this host. For a local test with no DNS, use `:80` — Caddy
# then serves plain HTTP and skips ACME entirely.
DOMAIN=logger.example.com

# ── Database ──────────────────────────────────────────────────────────────────
# `postgres` is the compose service name; the database is not published to the
# host. Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_DB=logger
POSTGRES_USER=logger
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://logger:change-me@postgres:5432/logger

# ── ClickHouse ────────────────────────────────────────────────────────────────
# The events store. `clickhouse` is the compose service name; like Postgres it
# is not published to the host. The HTTP interface (8123), not the native
# protocol on 9000 — @clickhouse/client speaks HTTP.
CLICKHOUSE_DATABASE=logger
CLICKHOUSE_USER=logger
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_URL=http://clickhouse:8123

# ── ClickHouse tuning ─────────────────────────────────────────────────────────
# Read by db/clickhouse/config.d/logger.xml through `from_env`. Omitting them
# leaves ClickHouse's own defaults, which assume a **dedicated machine**: it
# sizes caches against all visible RAM. On a shared host that is wrong in the
# direction that gets something OOM-killed.
#
# 3 GiB is the budget docs/features/09-clickhouse.md §15 allocates on the 8 GB
# host (roughly PG 1 GB, ClickHouse 3-4 GB, app 1.5 GB), and it is the ceiling
# every Phase 0 measurement was taken under — so the numbers in §14 describe a
# server configured this way and not a laptop with 32 GB.
CLICKHOUSE_MAX_SERVER_MEMORY=3221225472

# Marks are the sparse primary index — the cache that decides whether granule
# skipping is cheap. The stock default is 5 GB, which alone would exceed the
# ceiling above. 512 MiB, deliberately modest, as in the Phase 0 lab.
CLICKHOUSE_MARK_CACHE_SIZE=536870912

# fatal | critical | error | warning | information | debug | trace
CLICKHOUSE_LOG_LEVEL=warning

# **The two budgets below do not yet add up, and that is deliberate.** The
# Postgres profile that follows is sized for a Postgres that still owns
# `events`, because it does — the read and write paths do not move until
# Phases 2-4. Adding ClickHouse's 3 GiB on top oversubscribes the host on
# paper. Until events actually leave Postgres, run ClickHouse with a *smaller*
# ceiling or on a host with room; the rebalance (PG down to ~1 GB) is Phase 6
# work and is deliberately not pre-applied here, since documenting a profile
# nobody has measured is how the 128 MB shared_buffers went unnoticed for two
# weeks.

# ── Postgres tuning ───────────────────────────────────────────────────────────
# Passed to the postgres command line by docker-compose.yml. Omitting any of
# them falls back to Postgres's own default, which is what this file shipped
# until 2026-08-24.
#
# **The profile below is sized for 8 GB RAM / 4 vCPU / NVMe, sharing the host
# with the app and the worker.** If your host differs, recompute rather than
# copy — the arithmetic for each line is given so you can. Changing any of
# these requires restarting postgres (`docker compose up -d postgres`).
#
# Why this stopped being commented out: the install ran on upstream defaults
# from first deploy, and on 2026-08-21 a dashboard query measured 17 s where
# the same work in cache costs 1–2 s. A ten-fold gap of that shape is a
# working set that does not fit in memory — and `shared_buffers=128MB` on a
# host holding a multi-gigabyte events table guarantees it does not. Full
# reasoning in docs/PLAN.md §17.

# 25% of RAM. On a *dedicated* database host 25% is the usual starting point;
# here it is an upper bound, because the app (~0.6 GB), the worker (~0.3 GB),
# Caddy and the backup container live on the same 8 GB.
PG_SHARED_BUFFERS=2GB

# shared_buffers + what the OS is realistically left to cache (~3 GB after the
# containers above). A planner hint only — it allocates nothing.
PG_EFFECTIVE_CACHE_SIZE=5GB

# Per sort/hash node, per connection — NOT per query and NOT per server, which
# is what makes a large value dangerous. Two pools of 10 (app, worker) with a
# couple of hash nodes each is a worst case near 1.3 GB, which 8 GB survives.
#
# 32 MB is sized to the largest GROUP BY we intend to keep: topMessages off the
# template rollup is ~18k groups ≈ 5 MB, and eventsPerMinute is 43,200 buckets.
# Both fit with room. The raw-text fallback (1.13M groups ≈ 300 MB) will still
# spill, deliberately — it is the path §16.3 exists to retire, and sizing
# work_mem for it would mean sizing it for the query we are deleting.
PG_WORK_MEM=32MB

# Index builds, and autovacuum on ~35 daily partitions. Not per connection —
# only maintenance operations take it, and few run at once.
PG_MAINTENANCE_WORK_MEM=512MB

# NVMe, not spinning rust. The 4.0 default encodes a ~40x random/sequential
# penalty that has not been true on this class of disk for a decade, and it
# biases the planner *away* from the index and rollup lookups this app is built
# around.
PG_RANDOM_PAGE_COST=1.1

# How many concurrent reads the planner assumes the disk can serve. Governs
# bitmap heap scans — which is what a GIN lookup (attributes, message search)
# and a partial-index lookup produce. Default 1 means "one at a time".
PG_EFFECTIVE_IO_CONCURRENCY=200

# Stock value, set explicitly because it only starts mattering now. On 2 shared
# vCPU there was nothing to schedule parallel workers on; on 4 there is.
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2

# Off, and this is the one setting that is not obvious.
#
# `events` is pg_partman daily-partitioned, so a 30-day plan carries ~30 scan
# nodes. JIT decides whether to compile from the *query's* total cost, then
# compiles per expression across every one of those nodes — so a wide
# partitioned plan pays compilation proportional to the partition count while
# the threshold that admitted it did not consider them. Our queries are bound
# by bytes read and hash-table size, not by expression evaluation, so there is
# nothing for JIT to win back.
#
# Turn it back on only with a before/after measurement, never on principle.
PG_JIT=off

# ── Postgres instruments (measurement, not tuning) ────────────────────────────
# These change no plan. They exist because until 2026-08-24 we could see that a
# query took 17 s and could not see whether it was waiting on disk — so the
# "not enough RAM" diagnosis was inference rather than evidence.

# Makes EXPLAIN (ANALYZE, BUFFERS) print "I/O Timings: read=…" and adds read
# time to pg_stat_statements. Overhead is negligible on Linux with a decent
# clocksource; confirm with `pg_test_timing` if a host behaves oddly.
PG_TRACK_IO_TIMING=on

# Log any sort or hash that spills to disk above this size, so the next
# work_mem decision is made from evidence rather than from the arithmetic
# above. -1 (the default) logs nothing.
PG_LOG_TEMP_FILES=10MB

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters; the app refuses to boot below that. Generate with:
#   openssl rand -base64 32
# Changing it invalidates every existing session.
AUTH_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL for invitation links and alert webhook payloads. Must match DOMAIN,
# including the scheme — a wrong value here produces webhooks whose events_url
# points somewhere nobody can open, and nothing else visibly breaks.
APP_URL=https://logger.example.com

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Fallback ingest quota (events per 60s) for API keys with no per-key override.
RATE_LIMIT_PER_MIN=1000

# Lets alert webhooks reach private/loopback addresses. Leave false unless this
# install genuinely posts to a service on the same private network — enabling it
# turns the webhook sender into an SSRF primitive.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Runs pg-boss inside the Next.js process. Must stay false in production: the
# `worker` service is the job runner, and turning this on would give the alert
# evaluator a second scheduler racing the first.
WORKER_IN_PROCESS=false

# NODE_ENV is deliberately NOT set here. It is baked into the image
# (`ENV NODE_ENV=production` in the Dockerfile) so that all three processes get
# it — `app`, and equally the plain-`node` `worker` and `migrate` containers,
# which have no framework to default it for them. Setting it here as well is
# harmless; setting it to anything other than `production` silently selects
# development branches, including the pooled-client global in core/db/client.ts.

# ── Container port ────────────────────────────────────────────────────────────
# What the app listens on inside its container. Defaults to the image's baked-in
# 3000 if unset. It is NOT the 80 that `npm run start` uses locally — that only
# governs a local `next start`, which the container never runs. Changing this
# means changing `ENV PORT` in the Dockerfile and `reverse_proxy app:3000` in
# the Caddyfile to match.
PORT=3000

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
# Local copies to keep. Small on purpose — the offsite bucket is the archive,
# local files exist to make a same-day restore fast.
BACKUP_RETENTION_COUNT=3

# Offsite copy via rclone. With OFFSITE=true, RCLONE_REMOTE is required and the
# backup container refuses to start without it.
OFFSITE=false
RCLONE_REMOTE=b2:logger-backups/logger.example.com

# The remote is configured through rclone's own environment variables rather
# than an rclone.conf file, so every secret stays in this one file. The segment
# after RCLONE_CONFIG_ is the remote name used in RCLONE_REMOTE above, upper-
# cased. Example for Backblaze B2 (remote named `b2`):
#
#   RCLONE_CONFIG_B2_TYPE=b2
#   RCLONE_CONFIG_B2_ACCOUNT=...
#   RCLONE_CONFIG_B2_KEY=...
#
# Or for any S3-compatible bucket (remote named `s3`):
#
#   RCLONE_CONFIG_S3_TYPE=s3
#   RCLONE_CONFIG_S3_PROVIDER=Other
#   RCLONE_CONFIG_S3_ENDPOINT=https://...
#   RCLONE_CONFIG_S3_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=...

# ── Build metadata (build time only) ──────────────────────────────────────────
# Surfaced by GET /api/version. These are NEXT_PUBLIC_, so `next build` inlines
# them into the client bundle: they are read as build args and setting them here
# after the fact has no effect. The release workflow passes them automatically;
# set them only for a manual `docker compose build`.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME=

# Image `docker compose` builds and runs. Leave as-is to build from this
# checkout; point it at a published tag (ghcr.io/<owner>/logger:v1.2.3) to
# deploy a prebuilt image instead — see docs/OPERATIONS.md.
IMAGE=logger:latest
