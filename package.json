{
  "name": "logger",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 80",
    "build": "next build && node scripts/build-worker.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -p 80",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:e2e": "node scripts/migrate-e2e.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "demo": "node scripts/demo-live.mjs",
    "test:it": "vitest run --config vitest.integration.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:seed": "node scripts/seed-bench.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@reduxjs/toolkit": "^2.11.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "gform-react": "^2.8.2",
    "next": "16.2.4",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "sass": "^1.99.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
